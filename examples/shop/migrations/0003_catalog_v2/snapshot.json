    },
    "shop_audit.log_change()": {
      "schema": "shop_audit",
      "name": "log_change",
      "args": "",
      "returns": "trigger",
      "language": "plpgsql",
      "body": "\nBEGIN\n  INSERT INTO shop_audit.audit_log (table_name, action, row_id, data)\n  VALUES (\n    TG_TABLE_NAME,\n    lower(TG_OP)::shop_audit.audit_action,\n    CASE WHEN TG_OP = 'DELETE' THEN OLD.id::text ELSE NEW.id::text END,\n    CASE WHEN TG_OP = 'DELETE' THEN to_jsonb(OLD) ELSE to_jsonb(NEW) END\n  );\n  RETURN NULL;\nEND\n",
      "volatility": "volatile",
      "security_definer": true,
      "settings": {
        "search_path": "pg_catalog, pg_temp"
      }
    },
    "public.price_changed()": {
      "schema": "public",
      "name": "price_changed",
      "args": "",
      "returns": "trigger",
      "language": "plpgsql",
      "body": "\nBEGIN\n  PERFORM pg_notify('shop_price', json_build_object(\n    'product_id', NEW.id, 'old', OLD.price, 'new', NEW.price)::text);\n  INSERT INTO notifications (user_id, kind, payload)\n  SELECT s.owner_id, 'price_changed',\n         jsonb_build_object('product_id', NEW.id, 'old', OLD.price, 'new', NEW.price)\n  FROM stores s WHERE s.id = NEW.store_id;\n  RETURN NULL;\nEND\n",
      "volatility": "volatile",
      "security_definer": false
    }
  }
